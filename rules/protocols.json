        { "regex": "(?i)\\bcourier\\b", "product": "Courier" }
      ]
    },
    {
      "id": "memcached",
      "protocol": "Memcached",
      "description": "文本协议：VERSION <ver> / ERROR。",
      "any": [
        { "type": "regex", "value": "(?i)^version[ ]([0-9][0-9a-z.\\-]*)" },
